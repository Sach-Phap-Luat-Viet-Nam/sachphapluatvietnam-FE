# Gốc URL backend, không có /api/v1. Backend chạy local: http://localhost:5279
API_BASE_URL=https://sachphapluatvietnam.onrender.com

# Secret dùng chung với backend để backend tin header x-client-ip từ proxy. Để trống ở local.
PROXY_SECRET=

# Header lấy IP thật của khách cho proxy. Để trống là x-forwarded-for (Vercel); sau Cloudflare đặt cf-connecting-ip.
CLIENT_IP_HEADER=

# Gốc URL Storefront (không có dấu / cuối), dùng để mở tab đăng nhập hộ khách hàng. Đọc lúc build (NEXT_PUBLIC_).
NEXT_PUBLIC_STOREFRONT_URL=https://sachphapluatvietnam.vercel.app

# Pusher Channels (thông báo realtime khi bị đăng nhập nơi khác / buộc đăng xuất). Đọc lúc build (NEXT_PUBLIC_);
# để trống thì tắt thông báo, phiên vẫn bị kết thúc ở lần gọi API kế tiếp.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
